  {
   "cell_type": "markdown",
   "id": "880a39a6-f5a9-44e4-a548-229376f58496",
   "metadata": {},
   "source": [
    "### Frank2D"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 31,
   "id": "e79a4162-60bf-41b9-9379-f827e8190f30",
   "metadata": {},
   "outputs": [],
   "source": [
    "x_arcsec, y_arcsec = frank2d.x*rad_to_arcsec, frank2d.y*rad_to_arcsec\n",
    "extent_convention = [-x_arcsec[0], -x_arcsec[-1], -y_arcsec[-1], -y_arcsec[0]]\n",
    "model = frank2d.intensity_model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "bd727551-dd88-42be-a07b-04ae6ccbc395",
   "metadata": {},
   "outputs": [],
   "source": [
    "# let's do a phase shift first.\n",
    "u_ = frank2d.u_grid\n",
    "v_ = frank2d.v_grid\n",
    "vis_ = frank2d.visibility_model\n",
    "vis = geom.apply_phase_shift(-u_, -v_, vis_)\n",
    "I_shifted = frank2d.transform(vis).real"
   ]
  },
