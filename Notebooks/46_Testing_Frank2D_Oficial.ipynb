    "## Comparing CLEAN image"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "7b1fd1f2-4166-46a7-9909-a1d0436c98b9",
   "metadata": {},
   "outputs": [],
   "source": [
    "import matplotlib.colors as colors\n",
    "\n",
    "from astropy.io import fits\n",
    "from astropy.wcs import WCS\n",
    "from astropy.coordinates import SkyCoord\n",
    "import astropy.units as u\n",
    "from scipy.ndimage import shift as ndshift"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9e9f66d6-8199-450d-83ea-2960d6bf1bdd",
   "metadata": {},
   "source": [
    "### CLEAN"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "5cba7e66-f18b-40b3-aca7-d3ec53aafed4",
   "metadata": {},
   "outputs": [],
   "source": [
    "dir =  \"/Users/mariajmelladot/Desktop/Frank2D/data/fits/\"\n",
    "disk = disk_name + '_continuum.fits'\n",
    "\n",
    "fits_name = dir + disk\n",
    "fits_image = fits.open(fits_name)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "54275dbb-60ae-4422-8117-f5d44cadb81f",
   "metadata": {},
   "outputs": [],
   "source": [
    "header = fits_image[0].header"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "493a978b-1744-403b-8834-5e8de352b1a5",
   "metadata": {},
   "outputs": [],
   "source": [
    "w = WCS(header).celestial\n",
    "img_clean = np.squeeze(fits_image[0].data)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "id": "7f787557-f149-4707-9b54-d866d30371b8",
   "metadata": {},
   "outputs": [],
   "source": [
    "data = img_clean"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "f5c03477-de48-4def-b73b-88d27c76cf39",
   "metadata": {},
   "outputs": [],
   "source": [
    "dX_as, dY_as = dra, ddec"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "0476d305-9778-414f-b05d-cc84aacf884c",
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- inputs assumed: header, w (astropy WCS), img_clean, dX_as, dY_as,\n",
    "#                     frank2d, rad_to_arcsec, np, u, SkyCoord, ndshift ---\n",
    "\n",
    "hdr  = header.copy()\n",
    "data = img_clean\n",
    "\n",
    "# --- image center in pixel coordinates ---\n",
    "ny, nx = data.shape\n",
    "xc, yc = (nx - 1) / 2.0, (ny - 1) / 2.0\n",
    "\n",
    "# --- sky coord at current image center (pixel -> world) ---\n",
    "ra_c, dec_c = w.pixel_to_world_values(xc, yc)\n",
    "center_sky = SkyCoord(ra_c * u.deg, dec_c * u.deg)\n",
    "\n",
    "# --- sky coord that SHOULD land at the center after applying the offset ---\n",
    "target_sky = center_sky.spherical_offsets_by(dX_as * u.arcsec, dY_as * u.arcsec)\n",
    "\n",
    "# --- where does that target currently fall? (world -> pixel) ---\n",
    "x1, y1 = w.world_to_pixel(target_sky)\n",
    "\n",
    "# --- required subpixel shift to bring target to the matrix center ---\n",
    "dx_pix = xc - x1\n",
    "dy_pix = yc - y1\n",
    "\n",
    "# --- shift the image (cubic interpolation) ---\n",
    "data_shifted = ndshift(data, shift=(dy_pix, dx_pix), order=3, mode=\"constant\", cval=np.nan)\n",
    "\n",
    "# --- update WCS: shifting +Δpix in the array => decrease CRPIX by -Δpix ---\n",
    "hdr[\"CRPIX1\"] = hdr[\"CRPIX1\"] + dx_pix\n",
    "hdr[\"CRPIX2\"] = hdr[\"CRPIX2\"] + dy_pix\n",
    "\n",
    "# --- pixel grid and world coords for the (shifted) image ---\n",
    "x_max_arcsec = float(frank2d.x_grid.max() * rad_to_arcsec)  # desired half-size (arcsec)\n",
    "\n",
    "Xpix, Ypix = np.meshgrid(np.arange(nx), np.arange(ny), indexing=\"xy\")\n",
    "RA_deg, DEC_deg = w.pixel_to_world_values(Xpix, Ypix)\n",
    "\n",
    "# Offsets relative to CRVAL (includes cos(dec) factor automatically)\n",
    "ref_sky = SkyCoord(hdr[\"CRVAL1\"] * u.deg, hdr[\"CRVAL2\"] * u.deg)\n",
    "grid_sky = SkyCoord(RA_deg * u.deg, DEC_deg * u.deg)\n",
    "dx, dy = ref_sky.spherical_offsets_to(grid_sky)  # angles on the tangent plane\n",
    "\n",
    "X_as = dx.to(u.arcsec).value   # +X: East\n",
    "Y_as = -dy.to(u.arcsec).value   # +Y: North\n",
    "\n",
    "# --- build a ±R arcsec mask and compute a tight bounding box in pixels ---\n",
    "R = x_max_arcsec +0.1\n",
    "mask = (np.abs(X_as) <= R) & (np.abs(Y_as) <= R)\n",
    "ys, xs = np.where(mask)\n",
    "\n",
    "y0, y1 = ys.min(), ys.max() + 1\n",
    "x0, x1 = xs.min(), xs.max() + 1\n",
    "\n",
    "# --- coherent crops (data and coordinate grids) ---\n",
    "data_clean = data_shifted[y0:y1, x0:x1]\n",
    "X_clean = X_as[y0:y1, x0:x1] # arcsecs\n",
    "Y_clean = Y_as[y0:y1, x0:x1]"
   ]
  },
